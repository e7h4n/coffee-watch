# esp-launcher app variant: build with
#   idf.py -B build-launcher -DSDKCONFIG=build-launcher/sdkconfig \
#     -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.launcher" build
# The watch must keep working offline: it validates itself after local health checks and
# never falls back to the launcher just because the hub is unreachable.
CONFIG_CW_LAUNCHER_APP=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-launcher.csv"
CONFIG_OKOU_MAX_FAIL_BOOTS=0
# Full ELF SHA-256 in core dumps so esp-launcher tools/symbolize.py can match the exact ELF.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
# Crash evidence for the launcher's coredump op (coredump partition exists in the launcher layout).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# Internal RAM. The launcher variant runs the okou_agent tasks (agent, Wi-Fi manager, hub
# websocket of about 5 KB each, stacks in internal RAM) on top of BLE, the display and Dropbox
# TLS. Without this the hub websocket task could not be created (v0.1.9). Moving the Wi-Fi hot
# paths out of IRAM frees roughly 27 KB of internal SRAM for the heap; NimBLE host buffers go to
# PSRAM. Wi-Fi throughput is lower, which the watch does not need.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# More internal heap headroom for hub reconnects (v0.1.11 ran with a 7.7 KB largest block against
# the ~5.5 KB the websocket task needs): non-ISR FreeRTOS functions run from flash (up to 8 KB).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
# Offline recovery: a running app boots straight back into itself, so hold the select button
# (GPIO1) for 3 s while the watch starts to open the launcher's BLE provisioning (new Wi-Fi,
# new device token from hub.c3p0.dev/setup).
CONFIG_OKOU_SETUP_BUTTON_GPIO=1
CONFIG_OKOU_SETUP_BUTTON_HOLD_MS=3000
